; Copy to .env on the server. Put values with symbols in double quotes: DB_PASS="p@ss!word"
APP_ENV=production
APP_DEBUG=0
DB_HOST=localhost
DB_NAME="cpaneluser_process"
DB_USER="cpaneluser_app"
DB_PASS="change-me"
APP_URL="https://process.yourcompany.com"   ; REQUIRED in production: reset-email links are built from it
; Optional:
; Email. Without SMTP_HOST the server's PHP mail() is used. With it, mail goes through your SMTP account (test: php database/test_mail.php you@yourdomain.com)
MAIL_FROM="Strata Process <no-reply@yourdomain.com>"
; SMTP_HOST="mail.yourdomain.com"
; SMTP_PORT=587
; SMTP_SECURE=tls            ; tls (587, STARTTLS) | ssl (465) | none
; SMTP_USER="no-reply@yourdomain.com"
; SMTP_PASS="the-mailbox-password"
; MYSQLDUMP=/usr/bin/mysqldump
; BACKUP_KEEP_DAYS=30
; LOG_KEEP_DAYS=90
